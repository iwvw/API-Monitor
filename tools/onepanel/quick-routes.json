{
  "_comment": [
    "1Panel 快捷路由单一事实源。tools/gen-onepanel-catalog.mjs 读本文件 + 官方 swagger，",
    "生成 backend-go/internal/onepanel/catalog.json、onepanel 路由表，以及 system 层的",
    "文档 seed / 请求契约 / search 默认请求体。",
    "",
    "字段说明：",
    "  prefix      API Monitor 对外路径（与 manifest 前缀匹配规则一致）",
    "  kind        local=后端本地实现（不走 1Panel）| aggregate=多次 1Panel 调用聚合 | proxy=单次代理",
    "  methods     对外可用方法（按 handler 真实能力，必须与 kind/upstream 自洽）",
    "  upstream    方法 -> 1Panel 上游；path 支持 {id} 形式引用对外路径段",
    "  defaults    search 类接口的基线请求体；生成器会再自动补齐 swagger 声明的 required 字段",
    "  query       该接口对外暴露的查询参数（生成器校验其在上游 swagger 中存在）",
    "",
    "改完本文件后执行：npm run onepanel:generate"
  ],
  "swaggerVersion": "v2.4.1",
  "routes": [
    {
      "prefix": "/api/onepanel/config",
      "module": "onepanel-config",
      "matchMode": "exact",
      "kind": "local",
      "methods": [
        "GET",
        "POST"
      ],
      "description": "列出或新增 1Panel 连接配置（serverId / apiKey / baseUrl）",
      "contract": {
        "required": [
          "serverId",
          "apiKey"
        ],
        "fields": {
          "serverId": {
            "type": "string",
            "description": "API Monitor 服务器 ID"
          },
          "apiKey": {
            "type": "string",
            "description": "1Panel API 签名密钥（core.db settings 的 ApiKey）"
          },
          "baseUrl": {
            "type": "string",
            "description": "面板基地址，默认 https://127.0.0.1:8888"
          }
        }
      }
    },
    {
      "prefix": "/api/onepanel/config/{serverId}",
      "module": "onepanel-config",
      "matchMode": "pattern",
      "kind": "local",
      "methods": [
        "PUT",
        "DELETE"
      ],
      "description": "更新或删除指定服务器的 1Panel 连接配置（只传 apiKey 或 baseUrl 时按部分更新处理）",
      "contract": {
        "required": [],
        "fields": {
          "apiKey": {
            "type": "string",
            "description": "新的 1Panel API 签名密钥；留空表示保持不变"
          },
          "baseUrl": {
            "type": "string",
            "description": "面板基地址；留空表示保持不变"
          }
        }
      }
    },
    {
      "prefix": "/api/onepanel/spec",
      "module": "onepanel-spec",
      "matchMode": "exact",
      "kind": "local",
      "methods": [
        "GET"
      ],
      "description": "读取内置的 1Panel 官方 API 目录（由官方 swagger 生成，含 method / path / summary / tag）",
      "contract": {
        "noBody": true
      }
    },
    {
      "prefix": "/api/onepanel/{serverId}/health",
      "kind": "proxy",
      "methods": [
        "GET"
      ],
      "description": "检查指定服务器上的 1Panel 面板连通性",
      "upstream": {
        "GET": {
          "path": "/dashboard/base/no/no"
