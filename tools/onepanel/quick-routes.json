          "path": "/dashboard/current/no/no"
        }
      },
      "contract": {
        "noBody": true
      }
    },
    {
      "prefix": "/api/onepanel/{serverId}/overview",
      "kind": "aggregate",
      "methods": [
        "GET"
      ],
      "description": "聚合读取面板状态、网站、容器与 OpenResty 摘要（4 次 1Panel 调用，单项失败只缺该字段）",
      "contract": {
        "noBody": true
      }
    },
