# ===================================
# API Monitor 环境变量模板
# 使用方法: 复制此文件为 .env 并根据需要修改
# ===================================

# --- 基础设置 ---
# 服务端口
PORT=3000

# 管理员初始密码 (仅在数据库为空时生效)
ADMIN_PASSWORD=<CHANGE_ME>

# 会话密钥 (建议设置一个长字符串以固定登录状态)
JWT_SECRET=<CHANGE_ME_TO_A_LONG_RANDOM_STRING>

# --- 日志设置 ---
# 日志级别 (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# --- 数据目录 ---
# 数据库和日志存放路径 (Docker 环境下建议保持默认)
DATA_DIR=/app/data

# 数据库文件名 (默认 data.db)
DB_NAME=data.db

# --- CDN 配置 (前端构建时生效) ---
# 是否启用 CDN 加载静态资源 (true/false)
# 启用后可显著减少打包体积，适合部署到带宽有限的环境
VITE_USE_CDN=true

# CDN 提供商选择 (仅当 VITE_USE_CDN=true 时生效)
# 可选值: npmmirror(默认/中国大陆推荐), jsdelivr, unpkg, bootcdn
VITE_CDN_PROVIDER=npmmirror
