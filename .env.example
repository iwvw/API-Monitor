# ===================================
# API Monitor 环境变量模板
# 使用方法: 复制此文件为 .env 并根据需要修改
# 所有变量均可省略，省略时使用代码内置默认值
# ===================================

# --- 基础设置 ---
# 运行环境：development 支持本地 HTTP；production 要求通过 HTTPS 反向代理访问
# （兼容旧变量 NODE_ENV 作为回退，APP_ENV 优先）
APP_ENV=development

# 服务监听地址与端口（GO_PORT 优先于 PORT）
GO_HOST=0.0.0.0
PORT=3000

# 生产环境会话 Cookie 安全属性（开发环境 HTTP 可保持 false）
SECURE_COOKIES=false

# 生产环境默认关闭本地 Shell 任务；仅在明确需要时开启
ALLOW_LOCAL_SHELL_TASKS=false

# 仅信任这些反向代理网段读取 X-Forwarded-For，例如 172.16.0.0/12
TRUSTED_PROXY_CIDRS=

# 跨域 API 客户端白名单，多个 Origin 用逗号分隔；同源部署留空
CORS_ALLOWED_ORIGINS=

# --- 认证与安全 ---
# 管理员初始密码 (仅在数据库为空时生效)
ADMIN_PASSWORD=<CHANGE_ME>

# 会话密钥 (建议设置一个长字符串以固定登录状态)
JWT_SECRET=<CHANGE_ME_TO_A_LONG_RANDOM_STRING>

# 数据加密主密钥（生产环境必填且至少 32 位；修改后已有密文将无法解密）
ENCRYPTION_KEY=<CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING>

# 演示模式 (true/false)，开启后展示体验数据
DEMO_MODE=false

# --- 数据目录 ---
# 数据库和日志存放路径 (Docker 环境下建议保持默认)
DATA_DIR=/app/data

# 数据库文件名 (默认 data.db)
DB_NAME=data.db

# 前端静态资源与自定义静态目录（默认 dist / public，一般不用改）
DIST_DIR=
PUBLIC_DIR=

# --- 模型网关与管理 AI ---
# 管理 AI 默认模型名（留空则面板内手动选择）
ADMIN_AI_DEFAULT_MODEL=

# 模型网关转发入口可接受的请求体上限 MB（默认 16；小内存主机可调小）
GATEWAY_BODY_MAX_MB=16

# --- 可选调优 ---
# 开启 pprof 性能剖析（仅排查性能问题时设为 1）
API_MONITOR_PPROF=0

# 内存守卫：设为 0/false/off/disabled/no 关闭；默认按容器/主机内存自动启用
API_MONITOR_MEMORY_GUARD=
# 内存上限 MB（不设置则按容器/主机内存比例估算）
API_MONITOR_MEMORY_LIMIT_MB=
# GC 触发比例（0-1，占上限的比例）
API_MONITOR_MEMORY_GC_TRIGGER_RATIO=
# 内存检查周期（秒）
API_MONITOR_MEMORY_CHECK_SECONDS=

# --- Agent 在线状态与持久化（后端侧） ---
# 在线状态模式：stable（默认）/ legacy
API_MONITOR_AGENT_PRESENCE_MODE=
# 以下仅 stable 模式生效
API_MONITOR_AGENT_SUSPECT_AFTER_MS=
API_MONITOR_AGENT_OFFLINE_AFTER_MS=
API_MONITOR_AGENT_STARTUP_GRACE_MS=
API_MONITOR_AGENT_RECOVERY_SAMPLES=
# Agent 指标 / 网络质量持久化间隔（毫秒）
API_MONITOR_AGENT_METRICS_PERSIST_INTERVAL_MS=
API_MONITOR_AGENT_NETWORK_QUALITY_PERSIST_INTERVAL_MS=

# Uptime 探活心跳数据保留天数
API_MONITOR_UPTIME_HEARTBEAT_RETENTION_DAYS=

# --- 第三方 API 地址覆盖（默认官方地址，一般无需修改） ---
ALIYUN_API_BASE_URL=
KOYEB_API_BASE_URL=
TENCENT_API_BASE_URL=

# --- 遗留兼容 ---
# 旧 Node 侧车服务的适配地址（Node 时代组件已不再维护，留空即可）
NODE_LEGACY_URL=

# --- Agent 客户端 (agent-rust) ---
# 连接面板地址（命令行参数 --server 优先）
API_MONITOR_SERVER=http://127.0.0.1:3000
# 主机实例 ID 与连接密钥（命令行参数 --id / -k 优先，面板添加主机后获取）
API_MONITOR_SERVER_ID=
API_MONITOR_KEY=
# Docker 镜像加速地址，多个用逗号分隔
API_MONITOR_DOCKER_REGISTRY_MIRRORS=
# 流量上报间隔（秒，默认 300，最小 60）
API_MONITOR_TRAFFIC_REPORT_SECS=300

# --- 开发 / 测试工具 ---
# 后端冒烟与巡检脚本默认地址
API_MONITOR_BASE_URL=http://127.0.0.1:3000
# 虚拟 Agent 联调参数
VIRTUAL_AGENT_URL=http://127.0.0.1:3000
VIRTUAL_AGENT_SERVER_ID=
VIRTUAL_AGENT_KEY=
