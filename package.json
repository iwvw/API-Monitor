{
  "name": "api-monitor",
  "version": "2.1.0",
  "description": "Multi-api monitoring dashboard",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run backend-go:dev\" \"vite\" --names \"backend,frontend\" --prefix-colors \"blue,green\"",
    "dev:simple": "vite",
    "drawio:install": "node tools/install-drawio.mjs",
    "icons:generate": "node tools/generate-simple-icons-css.mjs",
    "build": "npm run icons:generate && vite build",
    "dist:precompress": "node tools/precompress-dist.mjs dist",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,html}\" \"*.config.js\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,html}\"",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "version:patch": "npm version patch --no-git-tag-version --ignore-scripts",
    "version:minor": "npm version minor --no-git-tag-version --ignore-scripts",
    "version:major": "npm version major --no-git-tag-version --ignore-scripts",
    "backend-go:dev": "cd backend-go && powershell -NoProfile -Command \"$key = Get-Content ..\\.env | Where-Object { $_ -match '^ENCRYPTION_KEY=' } | Select-Object -First 1; if ($key -match '^ENCRYPTION_KEY=(.+)$') { $env:ENCRYPTION_KEY = $matches[1].Trim() }; go run ./cmd/api-monitor\"",
    "backend-go:start": "cd backend-go && ./api-monitor.exe",
    "backend-go:test": "cd backend-go && go test ./...",
    "backend-go:build": "cd backend-go && go build -o api-monitor.exe ./cmd/api-monitor",
    "agent:build:windows": "cargo build --manifest-path agent-rust/Cargo.toml --release && npm run agent:sync",
    "agent:sync": "node tools/sync-agent-binary.mjs",
    "db:audit": "cd backend-go && go run ./cmd/schema-audit",
    "ui:governance": "node tools/ui-governance-check.mjs",
    "docs:check": "node tools/docs-link-check.mjs",
    "kumo:registry": "node tools/kumo-registry-snapshot.mjs",
    "kumo:registry:check": "node tools/kumo-registry-snapshot.mjs --check",
    "governance:check": "node tools/three-side-governance-check.mjs && node tools/tz-governance-check.mjs && node tools/motion-governance-check.mjs && node tools/agent-version-governance.mjs",
    "gen-api-catalog": "node tools/gen-api-catalog.mjs",
    "backend-go:smoke": "node tools/backend-go-smoke.mjs",
    "refactor:snapshot": "node tools/refactor-snapshot.mjs",
    "refactor:snapshot-diff": "node tools/refactor-snapshot-diff.mjs",
    "backend:perf-baseline": "node tools/backend-performance-baseline.mjs",
    "audit:fast": "npm run icons:generate && npm run governance:check && npm run ui:governance && npm run kumo:registry:check && npm run docs:check && npm run lint && npm test",
    "audit:full": "npm run audit:fast && npm run backend-go:test && node tools/backend-route-inventory.mjs && npm run backend-go:smoke",
    "clean:check": "node tools/workspace-cleanup.mjs --check",
    "clean:workspace": "node tools/workspace-cleanup.mjs --apply",
    "security:audit": "node tools/dependency-audit.mjs --ecosystem npm",
    "security:audit:cargo": "node tools/dependency-audit.mjs --ecosystem cargo",
    "security:verify": "node tools/verify-audit-parsing.mjs && pwsh -NoProfile -File tools/gitleaks-config-check.ps1",
    "android:assemble": "cd mobile-android && gradlew.bat :app:assembleDebug",
    "android:test": "cd mobile-android && gradlew.bat :app:testDebugUnitTest"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.16.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/view": "^6.43.15",
    "@iconify-json/logos": "^1.2.18",
    "@iconify/react": "^6.0.3",
    "@lezer/markdown": "^1.8.1",
    "@milkdown/crepe": "^7.23.0",
    "@phosphor-icons/react": "^2.1.10",
    "@uiw/react-codemirror": "^4.25.11",
    "axios": "^1.21.0",
    "country-flag-icons": "^1.6.20",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "flag-icons": "^7.6.0",
    "jsqr": "^1.4.0",
    "katex": "^0.19.1",
    "marked": "^18.1.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-grid-layout": "2.2.4",
    "shiki": "^4.5.0",
    "simple-icons-font": "^16.36.0",
    "socket.io-client": "^4.8.3",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@5": "^5.0.12",
    "source-map-js": "^1.2.2",
    "prosemirror-view": "^1.42.6",
    "vue": "^3.5.43",
    "katex": "^0.19.1",
    "zod": "^4.6.7"
  }
}
