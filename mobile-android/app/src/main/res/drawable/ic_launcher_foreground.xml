<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景：一对花括号（API / JSON 契约）+ 中央运行状态点。

  注意：Android 会把未闭合的 path 自动闭合后填充。原版那条折线同时设了
  fillColor 和 strokeColor，结果被渲染成一块实心青色多边形。
  这里所有描边路径都显式写 android:fillColor="#00000000"。

  几何与安全区：
  自适应图标只显示 108x108 的中心 72x72（18..90），并放大填充。
  图形按 0.92 缩到 27.6..80.4 / 31.2..76.8，圆形遮罩下四角也不会被切。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.92"
        android:scaleY="0.92">

        <!-- 左花括号 -->
        <path
            android:pathData="M46.5,30 C38.5,30 34.5,34 34.5,42 L34.5,47 C34.5,50.5 32,53 27.5,54 C32,55 34.5,57.5 34.5,61 L34.5,66 C34.5,74 38.5,78 46.5,78"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="6.4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- 右花括号 -->
        <path
            android:pathData="M61.5,30 C69.5,30 73.5,34 73.5,42 L73.5,47 C73.5,50.5 76,53 80.5,54 C76,55 73.5,57.5 73.5,61 L73.5,66 C73.5,74 69.5,78 61.5,78"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="6.4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <!-- 运行状态点：深色描边把它与括号分开，避免视觉粘连 -->
        <path
            android:pathData="M54,54 m-7.6,0 a7.6,7.6 0 1,0 15.2,0 a7.6,7.6 0 1,0 -15.2,0"
            android:fillColor="#4FC3F7"
            android:strokeColor="@color/ic_launcher_background"
            android:strokeWidth="2.2" />

    </group>

</vector>
